# Never commit secrets. Copy to .env.local. Server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional separate Gemini model for audio transcription; defaults to GEMINI_MODEL.
GEMINI_TRANSCRIBE_MODEL=
# demo: local PostgreSQL (PGlite) + narrow deterministic parser; never on Vercel.
APP_MODE=demo
PORT=3000
# Commercial signup. Set true after applying migration 008 to the exclusive Vendixa project.
COMMERCIAL_SIGNUP_ENABLED=false
# Legacy invitation variables can remain during transition; no code is required for new accounts.
PILOT_SIGNUP_ENABLED=false
PILOT_INVITE_CODE=
# Single commercial plan. Default trial is 7 days and test price is 199 MXN.
VENDIXA_TRIAL_DAYS=7
VENDIXA_PLAN_PRICE_MXN=199
VENDIXA_PUBLIC_URL=https://www.vendixa.app/
# Mercado Pago test credentials only, from Pruebas → Credenciales de prueba. Test tokens may start APP_USR-. Never use a production token.
MP_TEST_ACCESS_TOKEN=
# Test buyer User ID from Mercado Pago test accounts; the server resolves its test email.
MP_TEST_BUYER_USER_ID=
# Restrict sandbox checkout to one dedicated Vendixa business.
MP_TEST_ALLOWED_BUSINESS_ID=
MP_WEBHOOK_SECRET=
MP_EXPECTED_COLLECTOR_ID=
# Server-enforced limits per user/business; audio is still capped at 3 MB / 60 s and batches at 8 operations.
PILOT_MESSAGES_PER_MINUTE=30
PILOT_MESSAGES_PER_DAY=250
# Set APP_MODE=live for Supabase + Gemini. Browser uses Supabase email/password login.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=
# Enable only after verifying bindings, secrets, and a test Meta number.
WHATSAPP_ENABLED=false

# Vercel raw request stream is required for WhatsApp HMAC. Also set in vercel.json.
NODEJS_HELPERS=0
# Optional live smoke test: dedicated Supabase project and a newly created Auth user.
TEST_USER_ID=
SUPABASE_PROJECT_REF_CONFIRM=
ALLOW_LIVE_SMOKE=
# Optional local WAV for the units live smoke: "Vendí 23.5 kilos de jitomate a 28 pesos el kilo".
INVENTORY_UNITS_VOICE_FILE=
# Optional deployment smoke. Enter pilot login locally; this file stays ignored as .env.local.
DEPLOYMENT_URL=
VERCEL_PROJECT_DOMAIN_CONFIRM=
DEPLOY_BUSINESS_ID=
DEPLOY_BUSINESS_NAME_CONFIRM=
TEST_EMAIL=
TEST_PASSWORD=
ALLOW_DEPLOY_SMOKE=
