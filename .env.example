# Never commit secrets. Copy to .env.local. Server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# demo: local PostgreSQL (PGlite) + narrow deterministic parser; never on Vercel.
APP_MODE=demo
PORT=3000
# Set APP_MODE=live for Supabase + Gemini. Browser uses Supabase email/password login.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=
# Enable only after verifying bindings, secrets, and a test Meta number.
WHATSAPP_ENABLED=false

# Vercel raw request stream is required for WhatsApp HMAC. Also set in vercel.json.
NODEJS_HELPERS=0
# Optional live smoke test: dedicated Supabase project and a newly created Auth user.
TEST_USER_ID=
SUPABASE_PROJECT_REF_CONFIRM=
ALLOW_LIVE_SMOKE=
# Optional deployment smoke. Enter pilot login locally; this file stays ignored as .env.local.
DEPLOYMENT_URL=
VERCEL_PROJECT_DOMAIN_CONFIRM=
DEPLOY_BUSINESS_ID=
DEPLOY_BUSINESS_NAME_CONFIRM=
TEST_EMAIL=
TEST_PASSWORD=
ALLOW_DEPLOY_SMOKE=
